# ─── Supabase (required) ───────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
#
# anon key: safe to expose in the browser — RLS protects your data.
# No service_role key needed for this app.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── LLM Provider (required) ──────────────────────────────
# The analyzer calls a chat-completions endpoint with these.
# Works with OpenAI, Groq, Together, Anyscale, or any
# OpenAI-compatible API. Point LLM_API_URL at your provider's
# /v1/chat/completions endpoint.
#
# Examples:
#   OpenAI:      https://api.openai.com/v1/chat/completions  (model: gpt-4o)
#   Groq:        https://api.groq.com/openai/v1/chat/completions  (model: llama-3.1-70b-versatile)
#   Together:    https://api.together.xyz/v1/chat/completions  (model: meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo)

LLM_API_URL=YOUR_LLM_CHAT_COMPLETIONS_URL
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_MODEL=YOUR_MODEL_NAME

# ─── Search API (optional) ────────────────────────────────
# Enables the "Check originality" feature, which searches public
# web content for potential source matches.
#
# Uses Google Custom Search JSON API.
# Free tier: 100 queries/day, $5 per 1,000 after.
# Docs: https://developers.google.com/custom-search/v1/overview
#
# To set up:
# 1. Create a Programmable Search Engine at https://programmablesearchengine.google.com/
# 2. Get your API key from https://console.cloud.google.com/apis/credentials
# 3. Get your Search Engine ID (CX) from the search engine settings
#
# SEARCH_API_URL=https://www.googleapis.com/customsearch/v1
# SEARCH_API_KEY=YOUR_GOOGLE_API_KEY
# SEARCH_ENGINE_ID=YOUR_SEARCH_ENGINE_ID
#
# Max search queries per document. Default: 10. Clamped to [1, 20].
# MAX_SEARCH_QUERIES=10

# ─── Upload limits (optional) ─────────────────────────────
# Max upload file size in MB. Default: 10. Clamped to [1, 50].
# NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
